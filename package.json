{
  "name": "habitacores",
  "version": "0.1.0",
  "private": true,
  "description": "Habitacores multi-tenant real-estate operating ecosystem.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:check": "pnpm --filter @habitacores/database db:check",
    "db:generate": "pnpm --filter @habitacores/database db:generate",
    "repository:policy": "node scripts/check-repository-policy.mjs",
    "workspace:boundaries": "node scripts/check-workspace-boundaries.mjs"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
