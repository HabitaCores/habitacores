{
  "name": "@habitacores/authorization",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side organization membership and permission enforcement.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "browser": {
    "./dist/index.js": false
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "cd ../.. && eslint --config packages/authorization/eslint.config.mjs packages/authorization/src packages/authorization/vitest.authorization.config.ts tests/integration/database-authorization.integration.test.ts --max-warnings=0",
    "test:authorization": "vitest run --config vitest.authorization.config.ts",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.integration.json"
  },
  "dependencies": {
    "@habitacores/auth": "workspace:*",
    "@habitacores/database": "workspace:*",
    "@habitacores/domain": "workspace:*",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@habitacores/config": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.3",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
